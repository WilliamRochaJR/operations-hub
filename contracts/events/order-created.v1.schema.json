{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operations-hub.dev/events/order-created.v1.schema.json",
  "title": "OrderCreated v1",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "correlationId", "aggregateId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "OrderCreated" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "aggregateId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["orderNumber", "status"],
      "properties": {
        "orderNumber": { "type": "string" },
        "status": { "const": "PENDING" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
